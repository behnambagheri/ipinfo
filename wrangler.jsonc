{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bea-ipinfo",
  "main": "dist/worker.mjs",
  "account_id": "65a8188637073a50148b1e6e59e1c1a9",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "IPINFO_CACHE_SIZE": "1000",
    "IPINFO_PORT_LOOKUP": "true"
  },
  "routes": [
    {
      "pattern": "ip.bea.sh",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/geolite2-assets",
    "binding": "GEOIP_ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "USAGE_DB",
      "database_name": "bea-ipinfo-usage",
      "database_id": "40ccce18-318f-413d-b8d3-cb586f5c41d8",
      "migrations_dir": "migrations"
    }
  ]
}
